# Gradio 前端应用配置文件示例
# 复制此文件为 .env 或直接设置环境变量

# 后端 API 基础 URL
# 如果后端运行在同一服务器的 8000 端口，使用：
# API_BASE_URL=http://localhost:8000

# 如果通过 SSH 端口转发访问（例如：ssh -L 8000:localhost:8000 user@server）
# 使用：
# API_BASE_URL=http://localhost:8000

# 如果后端在远程服务器上，使用服务器地址：
# API_BASE_URL=http://192.168.1.100:8000
# 或
# API_BASE_URL=http://your-server-ip:8000

# 如果使用域名：
# API_BASE_URL=http://api.example.com:8000

API_BASE_URL=http://localhost:8000

