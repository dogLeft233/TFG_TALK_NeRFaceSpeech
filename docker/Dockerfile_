# ==================== 基础镜像 ====================
# 使用 CUDA 12.4.1 devel 镜像（包含 nvcc）
FROM nvidia/cuda:12.1.0-devel-ubuntu22.04

# ==================== 环境变量 ====================
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    TORCH_HOME=/app/assets/.cache/torch \
    XDG_CACHE_HOME=/app/assets/.cache \
    HF_ENDPOINT=https://hf-mirror.com \
    HF_HOME=/app/assets/.cache/huggingface \
    CONDA_DIR=/opt/conda \
    PATH=/opt/conda/bin:$PATH \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_DIR=/etc/ssl/certs

# ==================== 配置 Ubuntu 镜像源（使用清华镜像）====================
RUN sed -i 's|http://archive.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list && \
    sed -i 's|http://.*archive.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/*.list 2>/dev/null || true

# ==================== 安装系统依赖 ====================
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        wget \
        curl \
        git \
        build-essential \
        cmake \
        ffmpeg \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libglib2.0-0 \
        libgl1-mesa-glx \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ==================== 安装 Miniconda ====================
RUN wget --quiet https://mirrors.tuna.tsinghua.edu.cn/anaconda/miniconda/Miniconda3-latest-Linux-x86_64.sh \
    -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh \
    && /opt/conda/bin/conda clean --all -y \
    && ln -s /opt/conda/etc/profile.d/conda.sh /etc/profile.d/conda.sh

# ==================== 配置 Conda 镜像源 ====================
RUN /opt/conda/bin/conda config --remove-key channels || true \
    && /opt/conda/bin/conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/main/ \
    && /opt/conda/bin/conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/free/ \
    && /opt/conda/bin/conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/pytorch/ \
    && /opt/conda/bin/conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/conda-forge/ \
    && /opt/conda/bin/conda config --set show_channel_urls yes \
    && /opt/conda/bin/conda config --set channel_priority strict \
    && /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main 2>/dev/null || true \
    && /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r 2>/dev/null || true \
    && /opt/conda/bin/conda tos accept --override-channels --channel https://conda.anaconda.org/conda-forge 2>/dev/null || true \
    && /opt/conda/bin/conda tos accept --override-channels --channel conda-forge 2>/dev/null || true

# ==================== 设置工作目录 ====================
WORKDIR /app

# ==================== 复制环境文件 ====================
# 只复制配置文件，不复制已创建的环境目录
COPY environment/package/ /app/environment/package/
COPY environment/*.yaml /app/environment/

# ==================== 创建必要的目录 ====================
RUN mkdir -p \
    /app/assets/.cache/torch \
    /app/assets/.cache/huggingface \
    /app/assets/models \
    /app/database/videos \
    /app/outputs/video \
    /app/outputs/audio \
    /app/NeRFFaceSpeech_Code/pretrained_networks \
    /app/environment/nerffacespeech \
    /app/environment/api \
    /app/environment/syncnet \
    /app/environment/llm_talk

# ==================== 声明挂载卷 ====================
# 这些目录建议通过卷挂载到宿主机，以便数据持久化
VOLUME ["/app/assets/.cache", "/app/assets/models", "/app/outputs", "/app/database"]

# ==================== 安装 nerffacespeech 环境 ====================
RUN /opt/conda/bin/conda env create -f /app/environment/package/nerffacespeech/environment.min.yaml \
    -p /app/environment/nerffacespeech \
    && /bin/bash -c "source /opt/conda/etc/profile.d/conda.sh \
    && conda activate /app/environment/nerffacespeech \
    && pip install -r /app/environment/package/nerffacespeech/requirements.torch.txt \
    && conda install -y https://anaconda.org/pytorch3d/pytorch3d/0.7.8/download/linux-64/pytorch3d-0.7.8-py39_cu121_pyt222.tar.bz2 \
    && pip install -r /app/environment/package/nerffacespeech/requirements.txt"

# ==================== 安装 nerffacespeech 额外的 pytorch3d/nvdiffrast 依赖 ====================
RUN /bin/bash -c "set -e \
    && source /opt/conda/etc/profile.d/conda.sh \
    && conda activate /app/environment/nerffacespeech \
    && pip install -r /app/environment/package/nerffacespeech/requirements.pytorch3d.txt --no-build-isolation"

# ==================== 复制项目代码 ====================

# # ==================== 在 nerffacespeech 环境中安装 nvdiffrast ====================
# RUN /bin/bash -c "set -e \
#     && source /opt/conda/etc/profile.d/conda.sh \
#     && conda activate /app/environment/nerffacespeech \
