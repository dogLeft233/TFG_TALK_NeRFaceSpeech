# Docker 目录的 Git 忽略配置

# ==================== 运行时数据目录 ====================
# 这些目录包含运行时生成的数据，不应提交到 Git

# 数据库文件（运行时数据）
database/
!database/.gitkeep

# 输出文件（生成的视频、音频等）
outputs/
!outputs/.gitkeep

# 数据目录（训练数据等）
data/
!data/.gitkeep

# 权重缓存目录
weights/
!weights/.gitkeep

# HuggingFace 模型缓存
Hugging_Face/
!Hugging_Face/.gitkeep

# 资源文件（如果包含运行时生成的内容）
# assets/  # 如果 assets 包含静态资源，应该保留；如果包含运行时数据，取消注释

# ==================== 模型文件 ====================
# 模型文件很大，不应提交到 Git（通过 volume 挂载）

NeRFFaceSpeech_Code/pretrained_networks/
!NeRFFaceSpeech_Code/pretrained_networks/.gitkeep

# ==================== 日志和临时文件 ====================

# 日志文件
*.log
logs/
*.log.*

# 临时文件
*.tmp
*.temp
.tmp/
.temp/

# Docker 构建缓存（可选，通常不需要）
.docker/

# ==================== 备份文件 ====================

# 配置文件备份
*.bak
*.backup
*.old
*~

# Docker Compose 备份
docker-compose.yml.bak
docker-compose.yml.backup

# ==================== 系统文件 ====================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ==================== IDE 和编辑器 ====================

.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# ==================== 其他 ====================

# 环境变量文件（可能包含敏感信息）
.env
.env.local
.env.*.local

# 测试文件
test_output/
test_data/

